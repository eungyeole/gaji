<Window
    x:Class="Rift.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Rift.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Rift">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox Width="190" Margin="8,0" Header="Branch"
                              ItemsSource="{x:Bind ViewModel.Branches}" SelectedItem="{x:Bind ViewModel.Branch, Mode=OneWay}"
                              SelectionChanged="Branch_SelectionChanged" />
                    <AutoSuggestBox Width="240" PlaceholderText="Search commits"
                                    TextChanged="Search_TextChanged" />
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton Icon="OpenFile" Label="Open" Click="OpenRepository_Click" />
            <AppBarButton Icon="Add" Label="New" Click="NewRepository_Click" />
            <AppBarButton Icon="Download" Label="Clone" Click="CloneRepository_Click" />
            <AppBarButton Icon="Refresh" Label="Refresh" Click="Refresh_Click" />
            <AppBarSeparator />
            <AppBarButton Icon="Sync" Label="Fetch" Click="Fetch_Click" />
            <AppBarButton Icon="Download" Label="Pull" Click="Pull_Click" />
            <AppBarButton Icon="Upload" Label="Push" Click="Push_Click" />
            <AppBarSeparator />
            <AppBarButton Icon="Accept" Label="Stage All" Click="StageAll_Click" />
            <AppBarButton Icon="Undo" Label="Unstage All" Click="UnstageAll_Click" />
            <AppBarSeparator />
            <AppBarButton Icon="Play" Label="Continue" Click="Continue_Click" IsEnabled="{x:Bind ViewModel.HasOperation, Mode=OneWay}" />
            <AppBarButton Icon="Cancel" Label="Abort" Click="Abort_Click" IsEnabled="{x:Bind ViewModel.HasOperation, Mode=OneWay}" />
            <AppBarSeparator />
            <AppBarButton Icon="Tag" Label="Create Tag" Click="CreateTag_Click" IsEnabled="{x:Bind ViewModel.HasSelectedCommit, Mode=OneWay}" />
            <AppBarButton Icon="World" Label="Add Remote" Click="AddRemote_Click" />
            <AppBarButton Icon="Contact" Label="Blame" Click="Blame_Click"
                          IsEnabled="{x:Bind ViewModel.HasSelectedFile, Mode=OneWay}" />
            <AppBarButton Icon="Library" Label="Add Worktree" Click="AddWorktree_Click" />
            <AppBarButton Icon="SyncFolder" Label="Submodules" Click="UpdateSubmodules_Click" />
            <AppBarButton Icon="Rename" Label="Rename Branch" Click="RenameBranch_Click" />
            <AppBarButton Label="New Branch" Click="NewBranch_Click" />
            <AppBarButton Icon="Delete" Label="Delete Branch" Click="DeleteBranch_Click" />
            <AppBarButton Icon="Save" Label="Stash" Click="Stash_Click" />
            <AppBarButton Icon="OpenFile" Label="Pop Stash" Click="PopStash_Click" />
            <AppBarSeparator />
            <AppBarButton Label="Use Current" Click="UseCurrent_Click" IsEnabled="{x:Bind ViewModel.HasSelectedConflict, Mode=OneWay}" />
            <AppBarButton Label="Use Incoming" Click="UseIncoming_Click" IsEnabled="{x:Bind ViewModel.HasSelectedConflict, Mode=OneWay}" />
        </CommandBar>

        <NavigationView Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" IsPaneToggleButtonVisible="False"
                        OpenPaneLength="280" IsPaneOpen="True">
            <NavigationView.PaneHeader>
                <StackPanel Spacing="4" Margin="8,12">
                    <TextBlock Text="{x:Bind ViewModel.RepositoryName, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.Branch, Mode=OneWay}" Opacity="0.65" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.PaneFooter>
                <StackPanel Margin="8" Spacing="6">
                    <TextBlock Text="Recent" FontWeight="SemiBold" />
                    <ListView ItemsSource="{x:Bind ViewModel.RecentRepositories}"
                              MaxHeight="180" SelectionChanged="RecentRepository_SelectionChanged" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="History" Icon="Clock" />
                <NavigationViewItem Content="Changes" Icon="Edit">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.ChangeCount, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Worktrees" Icon="Library">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.WorktreeCount, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Submodules" Icon="Folder">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.SubmoduleCount, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Stashes" Icon="Save">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.StashCount, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="180" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="12,8" Text="Working Copy" FontWeight="SemiBold" />
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Changes}" SelectionChanged="Change_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:FileChangeItem">
                                    <Grid Padding="8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Status}" FontFamily="Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Grid.Row="2" Margin="12,8" Text="History" FontWeight="SemiBold" />
                        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Commits}" SelectionChanged="Commit_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:CommitItem">
                                    <StackPanel Padding="8" Spacing="4">
                                        <TextBlock Text="{x:Bind RefLabel}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Subject}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Author}" Opacity="0.65" />
                                            <TextBlock Text="{x:Bind ShortId}" FontFamily="Consolas" Opacity="0.65" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <Rectangle Grid.Column="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Grid.Column="2" Padding="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" />
                        <TextBox Grid.Row="1" Margin="0,16,0,0" Text="{x:Bind ViewModel.DetailText, Mode=OneWay}"
                                 FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>

        <Grid Grid.Row="2" Padding="12" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBox Text="{x:Bind ViewModel.CommitMessage, Mode=TwoWay}" PlaceholderText="Commit message" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox Content="Amend" IsChecked="{x:Bind ViewModel.CommitAmend, Mode=TwoWay}" />
                    <CheckBox Content="Sign" IsChecked="{x:Bind ViewModel.CommitSign, Mode=TwoWay}" />
                    <CheckBox Content="Sign-off" IsChecked="{x:Bind ViewModel.CommitSignoff, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="Commit" Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Top" Click="Commit_Click" />
        </Grid>
    </Grid>
</Window>
